# OpenAI
OPENAI_API_KEY=sk-your-key-here
# Anthropic (only needed if LLM_PROVIDER=anthropic, or to back a litellm alias in litellm/config.yaml)
ANTHROPIC_API_KEY=
# litellm proxy (only needed if LLM_PROVIDER=litellm); leave empty to disable proxy auth
LITELLM_MASTER_KEY=
# Azure OpenAI (only needed if EMBEDDING_PROVIDER=azure) — same text-embedding-3-small model,
# served through your own Azure resource instead of openai.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
EMBEDDING_PROVIDER=local

# ChromaDB (Docker internal hostname)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://web

# Storage paths (inside container)
DATA_PROCESSED_PATH=/data/processed
KEDB_DB_PATH=/data/kedb/kedb.db
KEDB_DOCS_PATH=/data/kedb/articles
CHROMA_COLLECTION_TICKETS=tickets
CHROMA_COLLECTION_KEDB=kedb_articles

# Embeddings / LLM
# openai = requiere créditos en platform.openai.com
# azure  = mismo modelo text-embedding-3-small, vía tu propio recurso Azure OpenAI
# local  = modelo multilingüe en CPU (recomendado si hay error insufficient_quota)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
# LLM_PROVIDER: openai | anthropic | litellm (cualquier provider soportado por init_chat_model de langchain)
# litellm = enruta vía el proxy litellm (docker); LLM_MODEL debe coincidir con un model_name de litellm/config.yaml
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Pipeline
BATCH_SIZE=100
RANDOM_SEED=42

# ARQ / Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
